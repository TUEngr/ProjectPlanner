{
  "name": "Project Planner",
  "image": "mcr.microsoft.com/devcontainers/python:3",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Project Planner",
      "visibility": "private",
      "onAutoForward": "notify"
    }
  },
  "postAttachCommand": "bash server/start.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
